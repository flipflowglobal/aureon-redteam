{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m mypy:*)",
      "Bash(./setup.sh status)",
      "Bash(./setup.sh agy-status)",
      "Bash(./setup.sh claude-status)",
      "Bash(tools/sync_prompts.sh check)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/policy_wrap.py\""
          }
        ]
      }
    ]
  }
}
