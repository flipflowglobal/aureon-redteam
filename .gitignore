# Local opencode runtime state — never commit
.opencode/.cache/
.opencode/environment.d/
.opencode/agents/*.local.json
.opencode/sessions/
.opencode/backups/

# Environment and secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
secrets/
vault/

# Test / scratch artifacts
report.txt

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
# Python bytecode cache (policy wrap hook)
__pycache__/
*.pyc

# Gate toolchain virtualenv and generated gate artifacts
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
