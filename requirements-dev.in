# Full gate toolchain for glibc Linux hosts: the Python gate tools plus
# ruff and ShellCheck. On Termux, ruff and ShellCheck come from `pkg` instead
# (no Android wheels exist for them), and only requirements-gate.txt is
# installed. ruff is pinned to the version Termux packages so both platforms
# lint with the same rules.
#
# Regenerate the hash-pinned lockfile after editing this file:
#   uv pip compile requirements-dev.in --universal --python-version 3.11 \
#     --generate-hashes --output-file requirements-dev.txt
-r requirements-gate.in
ruff==0.17.6
shellcheck-py==0.11.0.1
